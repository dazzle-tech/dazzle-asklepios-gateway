<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="bs000000000062" author="Batool Sbaih">
    <dropNotNullConstraint
      tableName="price_list_setup"
      columnName="effective_from"
      columnDataType="date"/>

    <addColumn tableName="price_list_setup">
      <column name="short_name" type="varchar(100)"/>
      <column name="tax_id" type="bigint"/>
      <column name="nphies_payer_id" type="bigint"/>
      <column
        name="applies_to_all_facilities"
        type="boolean"
        defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
    </addColumn>

    <createIndex
      tableName="price_list_setup"
      indexName="idx_price_list_setup_facility_type_status">
      <column name="facility_id"/>
      <column name="type"/>
      <column name="status"/>
    </createIndex>

    <createIndex
      tableName="price_list_setup"
      indexName="idx_price_list_setup_payer_status">
      <column name="payer_id"/>
      <column name="nphies_payer_id"/>
      <column name="status"/>
    </createIndex>
  </changeSet>

  <changeSet id="1787643600-2-price-list-setup-item" author="asklepios">
    <addColumn tableName="price_list_setup_item">
      <column name="category" type="varchar(50)"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
