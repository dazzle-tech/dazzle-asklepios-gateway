<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="BM000000000046" author="BushraMashaiekh">

    <createTable tableName="billing_charge">

      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="charge_number" type="varchar(50)">
        <constraints nullable="false"/>
      </column>

      <column name="patient_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="encounter_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="charge_type" type="varchar(30)" defaultValue="ENCOUNTER">
        <constraints nullable="false"/>
      </column>

      <column name="currency" type="varchar(30)">
        <constraints nullable="false"/>
      </column>

      <column name="gross_amount"
              type="numeric(19,4)"
              defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="discount_amount"
              type="numeric(19,4)"
              defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="exemption_amount"
              type="numeric(19,4)"
              defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="tax_amount"
              type="numeric(19,4)"
              defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="net_amount"
              type="numeric(19,4)"
              defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="allocated_amount" type="numeric(19,4)" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="outstanding_amount" type="numeric(19,4)" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="line_count" type="integer" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="status" type="varchar(30)" defaultValue="DRAFT">
        <constraints nullable="false"/>
      </column>

      <column name="charge_date" type="timestamp">
        <constraints nullable="false"/>
      </column>

      <column name="confirmed_date" type="timestamp"/>

      <column name="closed_date" type="timestamp"/>

      <column name="cancelled_date" type="timestamp"/>

      <column name="cancelled_by" type="varchar(50)"/>

      <column name="cancellation_reason" type="varchar(500)"/>

      <column name="reversed_charge_id" type="bigint"/>

      <column name="idempotency_key" type="varchar(150)">
        <constraints nullable="false"/>
      </column>

      <column name="source_type" type="varchar(50)"/>

      <column name="source_id" type="bigint"/>

      <column name="source_reference" type="varchar(150)"/>

      <column name="notes" type="text"/>

      <column name="created_by" type="varchar(50)">
        <constraints nullable="false"/>
      </column>

      <column name="created_date" type="timestamp">
        <constraints nullable="false"/>
      </column>

      <column name="last_modified_by" type="varchar(50)"/>

      <column name="last_modified_date" type="timestamp"/>

    </createTable>


    <addForeignKeyConstraint
      baseTableName="billing_charge"
      baseColumnNames="patient_id"
      referencedTableName="patients"
      referencedColumnNames="id"
      constraintName="fk_billing_charge_patient"/>


    <addForeignKeyConstraint
      baseTableName="billing_charge"
      baseColumnNames="encounter_id"
      referencedTableName="patient_encounters"
      referencedColumnNames="id"
      constraintName="fk_billing_charge_encounter"/>

    <addForeignKeyConstraint
      baseTableName="billing_charge"
      baseColumnNames="reversed_charge_id"
      referencedTableName="billing_charge"
      referencedColumnNames="id"
      constraintName="fk_billing_charge_reversed_charge"/>

    <addUniqueConstraint
      tableName="billing_charge"
      columnNames="charge_number"
      constraintName="uq_billing_charge_number"/>

    <addUniqueConstraint
      tableName="billing_charge"
      columnNames="idempotency_key"
      constraintName="uq_billing_charge_idempotency_key"/>


    <sql>
      ALTER TABLE billing_charge
        ADD CONSTRAINT ck_billing_charge_non_negative_amounts
          CHECK (
            gross_amount &gt;= 0
              AND discount_amount &gt;= 0
              AND exemption_amount &gt;= 0
              AND tax_amount &gt;= 0
              AND net_amount &gt;= 0
              AND allocated_amount &gt;= 0
              AND outstanding_amount &gt;= 0
              AND line_count &gt;= 0
            );
    </sql>


    <sql>
      ALTER TABLE billing_charge
        ADD CONSTRAINT ck_billing_charge_net_amount
          CHECK (
            net_amount =
            gross_amount
              - discount_amount
              - exemption_amount
              + tax_amount
            );
    </sql>


    <sql>
      ALTER TABLE billing_charge
        ADD CONSTRAINT ck_billing_charge_allocation_balance
          CHECK (
            net_amount =
            allocated_amount
              + outstanding_amount
            );
    </sql>


    <sql>
      ALTER TABLE billing_charge
        ADD CONSTRAINT ck_billing_charge_not_self_reversed
          CHECK (
            reversed_charge_id IS NULL
              OR reversed_charge_id &lt;&gt; id
            );
    </sql>

    <sql>
      ALTER TABLE billing_charge
        ADD CONSTRAINT ck_billing_charge_cancellation_details
          CHECK (
            (
              status &lt;&gt; 'CANCELLED'
              )
              OR
            (
              status = 'CANCELLED'
                AND cancelled_date IS NOT NULL
                AND cancelled_by IS NOT NULL
                AND cancellation_reason IS NOT NULL
              )
            );
    </sql>

    <sql>
      ALTER TABLE billing_charge
        ADD CONSTRAINT ck_billing_charge_reversal_reference
          CHECK (
            (
              status &lt;&gt; 'REVERSED'
              )
              OR
            (
              status = 'REVERSED'
                AND reversed_charge_id IS NOT NULL
              )
            );
    </sql>


    <createIndex
      tableName="billing_charge"
      indexName="idx_billing_charge_patient">
      <column name="patient_id"/>
    </createIndex>

    <createIndex
      tableName="billing_charge"
      indexName="idx_billing_charge_encounter">
      <column name="encounter_id"/>
    </createIndex>

    <createIndex
      tableName="billing_charge"
      indexName="idx_billing_charge_status">
      <column name="status"/>
    </createIndex>

    <createIndex
      tableName="billing_charge"
      indexName="idx_billing_charge_date">
      <column name="charge_date"/>
    </createIndex>

    <createIndex
      tableName="billing_charge"
      indexName="idx_billing_charge_patient_status">
      <column name="patient_id"/>
      <column name="status"/>
    </createIndex>

    <createIndex
      tableName="billing_charge"
      indexName="idx_billing_charge_encounter_status">
      <column name="encounter_id"/>
      <column name="status"/>
    </createIndex>

    <createIndex
      tableName="billing_charge"
      indexName="idx_billing_charge_source">
      <column name="source_type"/>
      <column name="source_id"/>
    </createIndex>

    <createIndex
      tableName="billing_charge"
      indexName="idx_billing_charge_reversed_charge">
      <column name="reversed_charge_id"/>
    </createIndex>

  </changeSet>

</databaseChangeLog>
