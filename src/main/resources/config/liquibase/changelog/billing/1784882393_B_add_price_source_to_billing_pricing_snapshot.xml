<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

  <changeSet id="20260724-01-billing-pricing-price-source" author="bushra-batool">
    <preConditions onFail="HALT">
      <tableExists tableName="billing_pricing_snapshot"/>
    </preConditions>
    <addColumn tableName="billing_pricing_snapshot">
      <column name="price_source" type="varchar(30)" defaultValue="SETUP_FALLBACK"/>
      <column name="setup_source_id" type="bigint"/>
    </addColumn>
    <update tableName="billing_pricing_snapshot">
      <column name="price_source" value="SETUP_FALLBACK"/>
      <where>price_source IS NULL</where>
    </update>
    <addNotNullConstraint tableName="billing_pricing_snapshot" columnName="price_source" columnDataType="varchar(30)" defaultNullValue="SETUP_FALLBACK"/>
    <createIndex tableName="billing_pricing_snapshot" indexName="idx_billing_pricing_snapshot_setup_source">
      <column name="setup_source_id"/>
    </createIndex>
    <rollback>
      <dropIndex tableName="billing_pricing_snapshot" indexName="idx_billing_pricing_snapshot_setup_source"/>
      <dropColumn tableName="billing_pricing_snapshot" columnName="setup_source_id"/>
      <dropColumn tableName="billing_pricing_snapshot" columnName="price_source"/>
    </rollback>
  </changeSet>
</databaseChangeLog>
