<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


  <changeSet id="BM000000000069" author="BushraMashaiekh">

    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists
          tableName="billing_pricing_snapshot"
          columnName="last_modified_by"/>
      </not>
    </preConditions>

    <addColumn tableName="billing_pricing_snapshot">
      <column
        name="last_modified_by"
        type="varchar(50)"/>
    </addColumn>

  </changeSet>

  <changeSet id="BM000000000070" author="BushraMashaiekh">

    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists
          tableName="billing_pricing_snapshot"
          columnName="last_modified_date"/>
      </not>
    </preConditions>

    <addColumn tableName="billing_pricing_snapshot">
      <column
        name="last_modified_date"
        type="timestamp"/>
    </addColumn>

  </changeSet>

</databaseChangeLog>
