<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="stimulsoft_report_template_template type_00000000000024" author="Sondos">
    <addColumn tableName="stimulsoft_report_template" schemaName="reports">
      <column name="template_type" type="varchar(50)"/>
    </addColumn>
  </changeSet>

  <changeSet id="stimulsoft_report_template_template type__00000000000025" author="Sondos">
    <addDefaultValue
      tableName="stimulsoft_report_template"
      schemaName="reports"
      columnName="template_type"
      defaultValue="REPORT"
     />
    <update tableName="stimulsoft_report_template" schemaName="reports">
      <column name="template_type" value="REPORT"/>
      <where>template_type IS NULL</where>
    </update>

    <addNotNullConstraint
      tableName="stimulsoft_report_template"
      schemaName="reports"
      columnName="template_type"
      columnDataType="varchar(50)"/>
  </changeSet>

</databaseChangeLog>
