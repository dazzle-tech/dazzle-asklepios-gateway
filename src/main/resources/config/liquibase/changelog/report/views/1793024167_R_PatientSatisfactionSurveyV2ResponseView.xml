<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1793024167_R_PATIENT_SATISFACTION_SURVEY_V2_RESPONSE_VIEW" author="Rawan-Yahya">
    <sql splitStatements="false">
      CREATE OR REPLACE VIEW reports.vwpatientsatisfactionsurveyv2response AS
      SELECT
        pssr.id,
        pssr.patient_name,
        pssr.status,
        pssr.started_at,
        pssr.completed_at,
        pssr.overall_score,
        pssr.overall_percentage,
        pssr.created_date
      FROM public.patient_satisfaction_survey_v2_response pssr;
    </sql>

    <rollback>
      <sql>
        DROP VIEW IF EXISTS reports.vwpatientsatisfactionsurveyv2response;
      </sql>
    </rollback>
  </changeSet>

  <changeSet id="1793024167_R_PATIENT_SATISFACTION_SURVEY_V2_RESPONSE_VIEW_ACCESS" author="Rawan-Yahya">
    <sql>
      GRANT USAGE ON SCHEMA reports TO report_user;
    </sql>

    <sql>
      GRANT SELECT ON reports.vwpatientsatisfactionsurveyv2response TO report_user;
    </sql>

    <rollback>
      <sql>
        REVOKE SELECT ON reports.vwpatientsatisfactionsurveyv2response FROM report_user;
      </sql>
    </rollback>
  </changeSet>
</databaseChangeLog>
