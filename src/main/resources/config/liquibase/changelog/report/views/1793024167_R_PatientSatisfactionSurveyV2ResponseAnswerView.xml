<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1793024167_R_PATIENT_SATISFACTION_SURVEY_V2_RESPONSE_ANSWER_VIEW" author="Rawan-Yahya">
    <sql splitStatements="false">
      CREATE OR REPLACE VIEW reports.vwpatientsatisfactionsurveyv2responseanswer AS
      SELECT
        pssra.id,
        pssra.response_id,
        pssra.question_code,
        pssra.score,
        pssra.answer_text
      FROM public.patient_satisfaction_survey_v2_response_answer pssra;
    </sql>

    <rollback>
      <sql>
        DROP VIEW IF EXISTS reports.vwpatientsatisfactionsurveyv2responseanswer;
      </sql>
    </rollback>
  </changeSet>

  <changeSet id="1793024167_R_PATIENT_SATISFACTION_SURVEY_V2_RESPONSE_ANSWER_VIEW_ACCESS" author="Rawan-Yahya">
    <sql>
      GRANT USAGE ON SCHEMA reports TO report_user;
    </sql>

    <sql>
      GRANT SELECT ON reports.vwpatientsatisfactionsurveyv2responseanswer TO report_user;
    </sql>

    <rollback>
      <sql>
        REVOKE SELECT ON reports.vwpatientsatisfactionsurveyv2responseanswer FROM report_user;
      </sql>
    </rollback>
  </changeSet>
</databaseChangeLog>
