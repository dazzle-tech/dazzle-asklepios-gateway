<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="create-report-diagnostic-order-test-technician-notes-view" author="sondos">
    <sql splitStatements="false">
      CREATE OR REPLACE VIEW reports.vwdiagnosticordertesttechniciannotes AS
      SELECT
        dotn.id,
        dotn.order_test_id,
        dotn.order_id,
        dotn.note,
        dotn.created_date,
        dotn.created_by,
        dotn.last_modified_by,
        dotn.last_modified_date
      FROM public.diagnostic_order_test_technician_notes dotn;
    </sql>

    <rollback>
      <sql>
        DROP VIEW IF EXISTS reports.vwdiagnosticordertesttechniciannotes;
      </sql>
    </rollback>
  </changeSet>
  <changeSet id="grant-report-diagnostic-order-test-technician-notes-view-access" author="sondos">
    <sql>
      GRANT USAGE ON SCHEMA reports TO report_user;
    </sql>

    <sql>
      GRANT SELECT ON reports.vwdiagnosticordertesttechniciannotes TO report_user;
    </sql>

    <rollback>
      <sql>
        REVOKE SELECT ON reports.vwdiagnosticordertesttechniciannotes FROM report_user;
      </sql>
    </rollback>
  </changeSet>
</databaseChangeLog>
