<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="create-report-diagnostic-order-test-report-comments-view" author="sondos">
    <sql splitStatements="false">
      CREATE OR REPLACE VIEW reports.vwdiagnosticordertestreportcomments AS
      SELECT
        c.id,
        c.order_test_id,
        c.report_id,
        c.note,
        c.created_date,
        c.created_by,
        c.last_modified_by,
        c.last_modified_date
      FROM public.diagnostic_order_test_report_comments c;
    </sql>

    <rollback>
      <sql>
        DROP VIEW IF EXISTS reports.vwdiagnosticordertestreportcomments;
      </sql>
    </rollback>
  </changeSet>
  <changeSet id="grant-report-diagnostic-order-test-report-comments-view-access" author="sondos">
    <sql>
      GRANT USAGE ON SCHEMA reports TO report_user;
    </sql>

    <sql>
      GRANT SELECT ON reports.vwdiagnosticordertestreportcomments TO report_user;
    </sql>

    <rollback>
      <sql>
        REVOKE SELECT ON reports.vwdiagnosticordertestreportcomments FROM report_user;
      </sql>
    </rollback>
  </changeSet>
</databaseChangeLog>
