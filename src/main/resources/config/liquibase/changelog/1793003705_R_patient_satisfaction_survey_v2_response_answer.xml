<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1793003705_R_PATIENT_SATISFACTION_SURVEY_V2_RESPONSE_ANSWER" author="Rawan-Yahya">

    <createTable tableName="patient_satisfaction_survey_v2_response_answer">

      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints
          primaryKey="true"
          primaryKeyName="pk_pss_v2_response_answer"
          nullable="false"/>
      </column>

      <column name="response_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <!-- The question ref from the survey sheet + its construct: C4_CLINICIAN_COMMUNICATION -->
      <column name="question_code" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>

      <!-- 1 to 5; empty for the free text question -->
      <column name="score" type="SMALLINT"/>

      <column name="answer_text" type="TEXT"/>

    </createTable>

    <addForeignKeyConstraint
      baseTableName="patient_satisfaction_survey_v2_response_answer"
      baseColumnNames="response_id"
      constraintName="fk_pss_v2_answer_response"
      referencedTableName="patient_satisfaction_survey_v2_response"
      referencedColumnNames="id"
      onDelete="CASCADE"/>

    <addUniqueConstraint
      tableName="patient_satisfaction_survey_v2_response_answer"
      columnNames="response_id, question_code"
      constraintName="uk_pss_v2_response_question"/>

  </changeSet>

</databaseChangeLog>
