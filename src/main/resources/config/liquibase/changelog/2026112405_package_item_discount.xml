<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="2026112405-add-package-item-discount" author="sondos">
    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists tableName="package_setup_item" columnName="discount_id"/>
      </not>
    </preConditions>
    <addColumn tableName="package_setup_item">
      <column name="discount_id" type="bigint"/>
    </addColumn>
    <addForeignKeyConstraint
      baseTableName="package_setup_item"
      baseColumnNames="discount_id"
      referencedTableName="discount"
      referencedColumnNames="id"
      constraintName="fk_package_setup_item_discount"
      onDelete="SET NULL"/>
  </changeSet>

</databaseChangeLog>
