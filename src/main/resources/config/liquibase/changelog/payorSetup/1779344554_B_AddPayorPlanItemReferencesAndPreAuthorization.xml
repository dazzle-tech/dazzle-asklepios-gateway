  <!-- ====================================================== -->
  <!-- Add Item Reference Check Constraint                   -->
  <!-- NOT VALID ignores existing invalid rows               -->
  <!-- New and updated rows must satisfy the constraint      -->
  <!-- ====================================================== -->

  <changeSet id="bs000000000043-10" author="batool">

    <preConditions onFail="MARK_RAN" onError="HALT">

      <and>

        <tableExists
          schemaName="public"
          tableName="payor_plan_item"/>

        <columnExists
          schemaName="public"
          tableName="payor_plan_item"
          columnName="item_type"/>

        <columnExists
          schemaName="public"
          tableName="payor_plan_item"
          columnName="brand_medication_id"/>

        <columnExists
          schemaName="public"
          tableName="payor_plan_item"
          columnName="diagnostic_test_id"/>

        <columnExists
          schemaName="public"
          tableName="payor_plan_item"
          columnName="service_id"/>

        <columnExists
          schemaName="public"
          tableName="payor_plan_item"
          columnName="procedure_id"/>

      </and>

    </preConditions>

    <sql
      dbms="postgresql"
      splitStatements="false"
      stripComments="false">

      <![CDATA[
      DO
      $$
      BEGIN

          IF NOT EXISTS (
            SELECT 1
            FROM pg_constraint constraint_definition
            INNER JOIN pg_class table_definition
              ON table_definition.oid = constraint_definition.conrelid
            INNER JOIN pg_namespace schema_definition
              ON schema_definition.oid = table_definition.relnamespace
            WHERE constraint_definition.conname = 'ck_ppi_item_reference_by_type'
              AND table_definition.relname = 'payor_plan_item'
              AND schema_definition.nspname = 'public'
          ) THEN

      ALTER TABLE public.payor_plan_item
        ADD CONSTRAINT ck_ppi_item_reference_by_type
          CHECK (
            (
              item_type = 'MEDICATION'
                AND brand_medication_id IS NOT NULL
                AND diagnostic_test_id IS NULL
                AND service_id IS NULL
                AND procedure_id IS NULL
              )

              OR

            (
              item_type IN (
                            'LABORATORY',
                            'RADIOLOGY',
                            'PATHOLOGY'
                )
                AND brand_medication_id IS NULL
                AND diagnostic_test_id IS NOT NULL
                AND service_id IS NULL
                AND procedure_id IS NULL
              )

              OR

            (
              item_type = 'SERVICE'
                AND brand_medication_id IS NULL
                AND diagnostic_test_id IS NULL
                AND service_id IS NOT NULL
                AND procedure_id IS NULL
              )

              OR

            (
              item_type = 'PROCEDURE'
                AND brand_medication_id IS NULL
                AND diagnostic_test_id IS NULL
                AND service_id IS NULL
                AND procedure_id IS NOT NULL
              )
            )
        NOT VALID;

      END IF;

      END
        $$;
      ]]>

    </sql>

    <rollback>

      <sql
        dbms="postgresql"
        splitStatements="false">

        <![CDATA[
          ALTER TABLE public.payor_plan_item
            DROP CONSTRAINT IF EXISTS ck_ppi_item_reference_by_type;
        ]]>

      </sql>

    </rollback>

  </changeSet>


