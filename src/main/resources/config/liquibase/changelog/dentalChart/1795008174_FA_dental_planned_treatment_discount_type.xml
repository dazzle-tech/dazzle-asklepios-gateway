<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- Discount Type for Treatment Plan lines: existing rows keep their discount as a FIXED amount. -->
  <changeSet id="FA000000000077" author="Faroukdhelea">
    <addColumn tableName="dental_planned_treatment">
      <column name="discount_type" type="varchar(10)" defaultValue="FIXED">
        <constraints nullable="false"/>
      </column>
    </addColumn>
    <sql>ALTER TABLE dental_planned_treatment ADD CONSTRAINT ck_dental_planned_treatment_discount_type CHECK (discount_type IN ('FIXED', 'PERCENT'))</sql>
  </changeSet>

</databaseChangeLog>
