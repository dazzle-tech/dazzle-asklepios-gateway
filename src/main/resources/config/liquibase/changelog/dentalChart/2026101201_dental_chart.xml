<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="dental_chart_create" author="hanan253yahya">
    <createTable tableName="dental_chart">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints nullable="false" primaryKey="true"/>
      </column>
      <column name="patient_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="encounter_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="chart_date" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="chart_type" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="status" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="treatment_plan" type="text"/>
      <column name="created_by" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="created_date" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>
    </createTable>

    <addForeignKeyConstraint
      baseTableName="dental_chart"
      baseColumnNames="patient_id"
      referencedTableName="patients"
      referencedColumnNames="id"
      constraintName="fk_dental_chart_patient"/>

    <addForeignKeyConstraint
      baseTableName="dental_chart"
      baseColumnNames="encounter_id"
      referencedTableName="patient_encounters"
      referencedColumnNames="id"
      constraintName="fk_dental_chart_encounter"/>

    <createIndex indexName="idx_dental_chart_patient_id" tableName="dental_chart">
      <column name="patient_id"/>
    </createIndex>

    <createIndex indexName="idx_dental_chart_encounter_id" tableName="dental_chart">
      <column name="encounter_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
