<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="tooth_cdt_create" author="hanan253yahya">
    <createTable tableName="tooth_cdt">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints nullable="false" primaryKey="true"/>
      </column>
      <column name="tooth_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="cdt_code_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="source" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="tooth_action_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="surface" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="is_cancelled" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="cancelled_date" type="timestamp"/>
      <column name="cancelled_by" type="varchar(50)"/>
      <column name="cancellation_reason" type="text"/>
      <column name="created_by" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="created_date" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>
    </createTable>

    <addForeignKeyConstraint
      baseTableName="tooth_cdt"
      baseColumnNames="tooth_id"
      referencedTableName="dental_chart_tooth"
      referencedColumnNames="id"
      constraintName="fk_tooth_cdt_tooth"/>

    <addForeignKeyConstraint
      baseTableName="tooth_cdt"
      baseColumnNames="cdt_code_id"
      referencedTableName="cdt_code"
      referencedColumnNames="id"
      constraintName="fk_tooth_cdt_cdt_code"/>

    <addForeignKeyConstraint
      baseTableName="tooth_cdt"
      baseColumnNames="tooth_action_id"
      referencedTableName="tooth_action"
      referencedColumnNames="id"
      constraintName="fk_tooth_cdt_tooth_action"/>

    <createIndex indexName="idx_tooth_cdt_tooth_id" tableName="tooth_cdt">
      <column name="tooth_id"/>
    </createIndex>

    <createIndex indexName="idx_tooth_cdt_tooth_action_id" tableName="tooth_cdt">
      <column name="tooth_action_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
