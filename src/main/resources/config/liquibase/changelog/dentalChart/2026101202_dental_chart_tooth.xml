<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="dental_chart_tooth_create" author="hanan253yahya">
    <createTable tableName="dental_chart_tooth">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints nullable="false" primaryKey="true"/>
      </column>
      <column name="chart_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="tooth_number" type="varchar(10)">
        <constraints nullable="false"/>
      </column>
      <column name="missing" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="created_date" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>
    </createTable>

    <addForeignKeyConstraint
      baseTableName="dental_chart_tooth"
      baseColumnNames="chart_id"
      referencedTableName="dental_chart"
      referencedColumnNames="id"
      constraintName="fk_dental_chart_tooth_chart"/>

    <addUniqueConstraint
      tableName="dental_chart_tooth"
      columnNames="chart_id, tooth_number"
      constraintName="uq_dental_chart_tooth_chart_number"/>

    <createIndex indexName="idx_dental_chart_tooth_chart_id" tableName="dental_chart_tooth">
      <column name="chart_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
