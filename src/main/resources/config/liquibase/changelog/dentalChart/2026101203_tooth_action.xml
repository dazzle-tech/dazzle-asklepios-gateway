<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="tooth_action_create" author="hanan253yahya">
    <createTable tableName="tooth_action">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints nullable="false" primaryKey="true"/>
      </column>
      <column name="tooth_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="dental_action_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="note" type="text"/>
      <column name="surface" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="existing" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="image_name" type="varchar(255)"/>
      <column name="tooth_number" type="varchar(10)">
        <constraints nullable="false"/>
      </column>
      <column name="is_cancelled" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="cancelled_date" type="timestamp"/>
      <column name="cancelled_by" type="varchar(50)"/>
      <column name="cancellation_reason" type="text"/>
      <column name="created_by" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="created_date" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>
    </createTable>

    <addForeignKeyConstraint
      baseTableName="tooth_action"
      baseColumnNames="tooth_id"
      referencedTableName="dental_chart_tooth"
      referencedColumnNames="id"
      constraintName="fk_tooth_action_tooth"/>

    <addForeignKeyConstraint
      baseTableName="tooth_action"
      baseColumnNames="dental_action_id"
      referencedTableName="dental_action"
      referencedColumnNames="id"
      constraintName="fk_tooth_action_dental_action"/>

    <createIndex indexName="idx_tooth_action_tooth_id" tableName="tooth_action">
      <column name="tooth_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
