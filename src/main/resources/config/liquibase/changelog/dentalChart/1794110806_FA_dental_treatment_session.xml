<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- New undeployed table: dental_treatment_session. Continues after FA000000000058. -->
  <changeSet id="FA000000000059" author="Faroukdhelea">
    <createTable tableName="dental_treatment_session">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="treatment_plan_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="session_number" type="integer">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="created_date" type="timestamp"/>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>
    </createTable>

    <addUniqueConstraint
      tableName="dental_treatment_session"
      columnNames="treatment_plan_id, session_number"
      constraintName="uk_dental_treatment_session_plan_number"/>

    <addForeignKeyConstraint
      baseTableName="dental_treatment_session"
      baseColumnNames="treatment_plan_id"
      referencedTableName="dental_treatment_plan"
      referencedColumnNames="id"
      constraintName="fk_dental_treatment_session_plan"/>
  </changeSet>

</databaseChangeLog>
