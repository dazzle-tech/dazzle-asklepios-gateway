<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!-- Incremental: scope/clinical fields on deployed dental_planned_treatment. Continues after FA000000000055. -->
  <changeSet id="FA000000000056" author="Faroukdhelea">
    <addColumn tableName="dental_planned_treatment">
      <column name="treatment_scope" type="varchar(50)" defaultValue="SPECIFIC_TOOTH">
        <constraints nullable="false"/>
      </column>
      <column name="covered_tooth_ids" type="TEXT"/>
      <column name="clinical_details" type="TEXT"/>
    </addColumn>

    <createIndex indexName="idx_dental_planned_treatment_scope" tableName="dental_planned_treatment">
      <column name="treatment_scope"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
