<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="dental_procedure_cancellation_columns" author="Rawan-Yahya">

    <addColumn tableName="dental_procedure">

      <column name="cancelled_date" type="timestamp"/>

      <column name="cancelled_by" type="varchar(50)"/>

      <column name="cancellation_reason" type="text"/>

    </addColumn>

  </changeSet>

</databaseChangeLog>

