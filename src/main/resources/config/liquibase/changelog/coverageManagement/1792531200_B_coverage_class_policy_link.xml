<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1792531200_B_coverage_class_policy_link" author="Batool_Bushra">
    <addColumn tableName="coverage_class">
      <column name="insurance_company_policy_id" type="bigint"/>
    </addColumn>

    <addForeignKeyConstraint
      baseTableName="coverage_class"
      baseColumnNames="insurance_company_policy_id"
      referencedTableName="insurance_company_policy"
      referencedColumnNames="id"
      constraintName="fk_coverage_class_ins_policy"/>

    <createIndex tableName="coverage_class" indexName="idx_coverage_class_ins_policy">
      <column name="insurance_company_policy_id"/>
    </createIndex>

    <dropIndex tableName="coverage_contract" indexName="idx_coverage_contract_policy"/>
    <dropColumn tableName="coverage_contract" columnName="policy_number"/>
  </changeSet>

</databaseChangeLog>
