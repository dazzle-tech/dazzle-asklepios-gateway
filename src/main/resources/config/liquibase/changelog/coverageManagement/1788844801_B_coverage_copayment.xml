<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="BS000000000065" author="bushra_batool">
    <createTable tableName="coverage_copayment">
      <column name="id" type="bigint" autoIncrement="true" startWith="1000">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="coverage_contract_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="encounter_type" type="varchar(30)">
        <constraints nullable="false"/>
      </column>
      <column name="value_type" type="varchar(30)">
        <constraints nullable="false"/>
      </column>
      <column name="value_amount" type="decimal(19,4)">
        <constraints nullable="false"/>
      </column>
      <column name="discount_on_excluded" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="discount_on_cash" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="discount_on_exceeded_cash" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="is_active" type="boolean" defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="created_date" type="timestamp" defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>
    </createTable>

    <addForeignKeyConstraint
      baseTableName="coverage_copayment"
      baseColumnNames="coverage_contract_id"
      referencedTableName="coverage_contract"
      referencedColumnNames="id"
      constraintName="fk_coverage_copayment_contract"
      onDelete="CASCADE"/>

    <createIndex tableName="coverage_copayment" indexName="idx_coverage_copayment_contract">
      <column name="coverage_contract_id"/>
    </createIndex>
  </changeSet>
</databaseChangeLog>
