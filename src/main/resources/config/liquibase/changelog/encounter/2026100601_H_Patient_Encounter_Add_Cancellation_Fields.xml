<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="2026100601_H_PATIENT_ENCOUNTERS_CANCELLATION_FIELDS" author="hanan">
    <addColumn tableName="patient_encounters">
      <column name="cancellation_reason" type="text">
        <constraints nullable="true"/>
      </column>
      <column name="cancelled_by" type="varchar(50)">
        <constraints nullable="true"/>
      </column>
      <column name="cancelled_at" type="timestamp">
        <constraints nullable="true"/>
      </column>
    </addColumn>
  </changeSet>

</databaseChangeLog>
