<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Multiple complaint attachments: metadata rows + S3/Spaces keys.
    Matches encounter_attachments / patient_attachments / pre_authorization_attachments
    (child table with parent FK, not a single column on the parent).
    Previous FA id: FA0000000051 (screen). This changeSet is FA0000000052.
  -->

  <changeSet id="FA0000000052" author="Faroukdhelea">
    <createTable tableName="patient_complaint_attachment">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_patient_complaint_attachment" nullable="false"/>
      </column>

      <column name="complaint_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="space_key" type="VARCHAR(500)">
        <constraints nullable="false"/>
      </column>

      <column name="filename" type="TEXT">
        <constraints nullable="false"/>
      </column>

      <column name="mime_type" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>

      <column name="size_bytes" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>

      <column name="created_by" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
      <column name="created_date" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
      <column name="last_modified_by" type="VARCHAR(50)"/>
      <column name="last_modified_date" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <addForeignKeyConstraint
      baseTableName="patient_complaint_attachment"
      baseColumnNames="complaint_id"
      referencedTableName="patient_complaint"
      referencedColumnNames="id"
      constraintName="fk_patient_complaint_attachment_complaint"
      onDelete="CASCADE"/>

    <createIndex tableName="patient_complaint_attachment" indexName="idx_patient_complaint_attachment_complaint_id">
      <column name="complaint_id"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
