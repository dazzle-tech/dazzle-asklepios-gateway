<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


  <changeSet id="FA0000000049" author="Faroukdhelea">
    <createSequence sequenceName="patient_complaint_reference_seq" startValue="1" incrementBy="1"/>

    <createTable tableName="patient_complaint">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_patient_complaint" nullable="false"/>
      </column>

      <column name="complaint_reference" type="VARCHAR(40)">
        <constraints nullable="false"/>
      </column>

      <column name="is_anonymous" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>

      <!-- Nullable link for authenticated mobile submissions; public/anonymous rows stay null. -->
      <column name="patient_id" type="BIGINT"/>

      <column name="patient_name" type="VARCHAR(255)"/>

      <column name="patient_identifier" type="VARCHAR(100)"/>

      <column name="document_type" type="VARCHAR(50)"/>

      <column name="document_number" type="VARCHAR(100)"/>

      <column name="contact_phone" type="VARCHAR(50)"/>

      <column name="contact_email" type="VARCHAR(255)"/>

      <column name="preferred_contact_method" type="VARCHAR(20)"/>

      <column name="on_behalf" type="BOOLEAN"/>

      <column name="relationship_to_patient" type="VARCHAR(100)"/>

      <column name="consent_to_contact" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>

      <column name="facility_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="facility_name" type="VARCHAR(255)"/>

      <column name="department_id" type="BIGINT"/>

      <column name="department_name" type="VARCHAR(255)"/>

      <column name="feedback_type" type="VARCHAR(40)">
        <constraints nullable="false"/>
      </column>

      <!-- Optional category (Medical Care, Billing, …); distinct from feedback_type -->
      <column name="complaint_type" type="VARCHAR(40)"/>

      <column name="incident_date" type="DATE"/>

      <column name="incident_time" type="TIME"/>

      <column name="subject" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>

      <column name="description" type="TEXT">
        <constraints nullable="false"/>
      </column>

      <column name="involved_staff_names" type="VARCHAR(500)"/>

      <column name="desired_resolution" type="TEXT"/>

      <column name="received_date" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>

      <column name="assigned_user_id" type="BIGINT"/>

      <column name="assigned_user_name" type="VARCHAR(255)"/>

      <column name="target_deadline" type="TIMESTAMP WITH TIME ZONE"/>

      <column name="status" type="VARCHAR(30)">
        <constraints nullable="false"/>
      </column>

      <column name="resolution_summary" type="TEXT"/>

      <column name="reopen_reason" type="TEXT"/>

      <column name="created_by" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
      <column name="created_date" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
      <column name="last_modified_by" type="VARCHAR(50)"/>
      <column name="last_modified_date" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <addUniqueConstraint
      tableName="patient_complaint"
      columnNames="complaint_reference"
      constraintName="uk_patient_complaint_reference"/>

    <createIndex tableName="patient_complaint" indexName="idx_patient_complaint_facility_id">
      <column name="facility_id"/>
    </createIndex>

    <createIndex tableName="patient_complaint" indexName="idx_patient_complaint_status">
      <column name="status"/>
    </createIndex>

    <createIndex tableName="patient_complaint" indexName="idx_patient_complaint_assigned_user_id">
      <column name="assigned_user_id"/>
    </createIndex>

    <createIndex tableName="patient_complaint" indexName="idx_patient_complaint_received_date">
      <column name="received_date"/>
    </createIndex>

    <createIndex tableName="patient_complaint" indexName="idx_patient_complaint_feedback_type">
      <column name="feedback_type"/>
    </createIndex>

    <createIndex tableName="patient_complaint" indexName="idx_patient_complaint_type">
      <column name="complaint_type"/>
    </createIndex>

    <createIndex tableName="patient_complaint" indexName="idx_patient_complaint_incident_date">
      <column name="incident_date"/>
    </createIndex>

    <createIndex tableName="patient_complaint" indexName="idx_patient_complaint_patient_id">
      <column name="patient_id"/>
    </createIndex>

    <addForeignKeyConstraint
      baseTableName="patient_complaint"
      baseColumnNames="patient_id"
      referencedTableName="patients"
      referencedColumnNames="id"
      constraintName="fk_patient_complaint_patient"
      onDelete="SET NULL"/>
  </changeSet>

</databaseChangeLog>
