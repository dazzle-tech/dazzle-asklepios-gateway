<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20260914_department_age_specific" author="hanan253yahya">
    <addColumn tableName="department">
      <column name="age_specific" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="from_age" type="decimal"/>
      <column name="from_age_unit" type="varchar(10)"/>
      <column name="to_age" type="decimal"/>
      <column name="to_age_unit" type="varchar(10)"/>
    </addColumn>




  </changeSet>

</databaseChangeLog>

