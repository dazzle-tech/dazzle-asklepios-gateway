<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
      http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="bs000000000060" author="Batool">

    <createTable tableName="claim_request">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="patient_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="encounter_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="financial_document_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="pre_authorization_id" type="bigint"/>
      <column name="patient_insurance_id" type="bigint"/>

      <column name="upload_name" type="varchar(200)"/>
      <column name="upload_id" type="bigint"/>
      <column name="prov_claim_no" type="varchar(200)"/>
      <column name="claim_reference" type="varchar(200)"/>
      <column name="pre_auth_ref_no" type="varchar(500)"/>
      <column name="approval_response_id" type="bigint"/>

      <column name="total_net" type="numeric(19,2)"/>

      <column name="status" type="varchar(50)">
        <constraints nullable="false"/>
      </column>

      <column name="outcome" type="varchar(100)"/>
      <column name="message" type="TEXT"/>
      <column name="request_json" type="TEXT"/>
      <column name="response_json" type="TEXT"/>
      <column name="submitted_at" type="timestamp"/>

      <column name="created_by" type="varchar(50)"/>
      <column name="created_date" type="timestamp"/>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>
    </createTable>

    <createIndex tableName="claim_request" indexName="idx_claim_request_encounter">
      <column name="encounter_id"/>
    </createIndex>

    <createIndex tableName="claim_request" indexName="idx_claim_request_document">
      <column name="financial_document_id"/>
    </createIndex>

    <createTable tableName="claim_item">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="claim_request_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="sequence" type="int">
        <constraints nullable="false"/>
      </column>

      <column name="patient_service_product_id" type="bigint"/>
      <column name="financial_document_item_id" type="bigint"/>
      <column name="billing_charge_line_id" type="bigint"/>

      <column name="item_type" type="varchar(50)"/>
      <column name="item_code" type="varchar(100)"/>
      <column name="item_description" type="varchar(500)"/>
      <column name="invoice_no" type="varchar(100)"/>

      <column name="quantity" type="numeric(19,4)"/>
      <column name="unit_price" type="numeric(19,2)"/>
      <column name="net" type="numeric(19,2)"/>
      <column name="patient_share" type="numeric(19,2)"/>
      <column name="payer_share" type="numeric(19,2)"/>

      <column name="created_by" type="varchar(50)"/>
      <column name="created_date" type="timestamp"/>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>
    </createTable>

    <createIndex tableName="claim_item" indexName="idx_claim_item_request">
      <column name="claim_request_id"/>
    </createIndex>

  </changeSet>

</databaseChangeLog>
