<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="BS000000000061" author="batool sbaih">

    <addColumn tableName="service_items">
      <column name="practitioner_id" type="bigint">
        <constraints nullable="true"
                     foreignKeyName="fk_service_items_practitioner"
                     references="practitioner(id)"/>
      </column>
    </addColumn>

    <dropUniqueConstraint
      tableName="service_items"
      constraintName="uk_service_items_service_type_source"/>

    <sql>
      CREATE UNIQUE INDEX uk_service_items_no_practitioner
        ON service_items (service_id, type, source_id)
        WHERE practitioner_id IS NULL;
    </sql>

    <sql>
      CREATE UNIQUE INDEX uk_service_items_with_practitioner
        ON service_items (service_id, type, source_id, practitioner_id)
        WHERE practitioner_id IS NOT NULL;
    </sql>

    <rollback>
      <sql>DROP INDEX IF EXISTS uk_service_items_with_practitioner;</sql>
      <sql>DROP INDEX IF EXISTS uk_service_items_no_practitioner;</sql>
      <addUniqueConstraint
        tableName="service_items"
        columnNames="service_id, type, source_id"
        constraintName="uk_service_items_service_type_source"/>
      <dropColumn tableName="service_items" columnName="practitioner_id"/>
    </rollback>

  </changeSet>

</databaseChangeLog>
