<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet
    id="CLAIM_ENCOUNTER_COPY_SURGICAL_HISTORIES"
    author="Rawan-Yahya">

    <createTable tableName="claim_encounter_copy_surgical_histories">

      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="claim_encounter_copy_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="surgical_history_id" type="bigint"/>

      <column name="surgery" type="varchar(255)"/>

      <column name="date_of_surgery" type="date"/>

      <column name="facility" type="varchar(255)"/>

      <column name="anesthesia_type" type="varchar(100)"/>

      <column name="complications" type="varchar(1000)"/>

      <column name="adverse_reactions_to_anesthesia" type="varchar(1000)"/>

      <column name="has_implants_or_devices" type="boolean"/>

      <column name="implants_or_devices_description" type="varchar(1000)"/>

      <column name="patient_is_free" type="boolean"
              defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>

      <column name="free_text" type="text"/>

      <column name="status" type="varchar(50)"
              defaultValue="ACTIVE">
        <constraints nullable="false"/>
      </column>

      <column name="cancelled_by" type="varchar(50)"/>

      <column name="cancelled_date" type="timestamp"/>

      <column name="cancellation_reason" type="text"/>

      <column name="created_by" type="varchar(50)"/>

      <column name="created_date" type="timestamp"/>

      <column name="last_modified_by" type="varchar(50)"/>

      <column name="last_modified_date" type="timestamp"/>

    </createTable>

    <addForeignKeyConstraint
      baseTableName="claim_encounter_copy_surgical_histories"
      baseColumnNames="claim_encounter_copy_id"
      constraintName="fk_claim_encounter_copy_surgical_histories_copy"
      referencedTableName="claim_encounter_copies"
      referencedColumnNames="id"/>

    <addForeignKeyConstraint
      baseTableName="claim_encounter_copy_surgical_histories"
      baseColumnNames="surgical_history_id"
      constraintName="fk_claim_encounter_copy_surgical_histories_history"
      referencedTableName="surgical_history"
      referencedColumnNames="id"/>

    <createIndex
      tableName="claim_encounter_copy_surgical_histories"
      indexName="idx_claim_encounter_copy_surgical_histories_copy">
      <column name="claim_encounter_copy_id"/>
    </createIndex>

    <createIndex
      tableName="claim_encounter_copy_surgical_histories"
      indexName="idx_claim_encounter_copy_surgical_histories_history">
      <column name="surgical_history_id"/>
    </createIndex>

  </changeSet>

</databaseChangeLog>
