<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="
                     http://www.liquibase.org/xml/ns/dbchangelog
                     http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="1792224042-create-encounter-dashboard-preference" author="farouk">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="encounter_dashboard_preference"/>
      </not>
    </preConditions>

    <createTable tableName="encounter_dashboard_preference">
      <column name="id" type="bigint" autoIncrement="true">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_encounter_dashboard_preference"/>
      </column>
      <column name="user_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="encounter_id" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="varchar(50)">
        <constraints nullable="false"/>
      </column>
      <column name="created_date" type="timestamp"/>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>
    </createTable>

    <addUniqueConstraint
      tableName="encounter_dashboard_preference"
      columnNames="user_id, encounter_id"
      constraintName="uk_encounter_dashboard_pref_user_encounter"/>

    <addForeignKeyConstraint
      baseTableName="encounter_dashboard_preference"
      baseColumnNames="user_id"
      referencedTableName="app_user"
      referencedColumnNames="id"
      constraintName="fk_encounter_dashboard_pref_user"
      onDelete="CASCADE"/>

    <addForeignKeyConstraint
      baseTableName="encounter_dashboard_preference"
      baseColumnNames="encounter_id"
      referencedTableName="patient_encounters"
      referencedColumnNames="id"
      constraintName="fk_encounter_dashboard_pref_encounter"
      onDelete="CASCADE"/>
  </changeSet>
</databaseChangeLog>
