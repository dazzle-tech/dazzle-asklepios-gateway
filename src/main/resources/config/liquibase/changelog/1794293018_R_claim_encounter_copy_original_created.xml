  <changeSet id="1794293018_R_claim_encounter_copy_original_created_backfill" author="Rawan-Yahya">
    <sql>
      UPDATE claim_encounter_diagnoses c
      SET original_created_by = s.created_by, original_created_date = s.created_date
      FROM patient_diagnoses s
      WHERE s.encounter_id = c.encounter_id AND s.diagnosis_id = c.diagnosis_id
        AND c.original_created_by IS NULL;

      UPDATE claim_encounter_progress_notes c
      SET original_created_by = s.created_by, original_created_date = s.created_date
      FROM progress_notes s
      WHERE s.id = c.progress_note_id AND c.original_created_by IS NULL;

      UPDATE claim_encounter_copy_social_histories c
      SET original_created_by = s.created_by, original_created_date = s.created_date
      FROM social_history s
      WHERE s.id = c.social_history_id AND c.original_created_by IS NULL;

      UPDATE claim_encounter_copy_surgical_histories c
      SET original_created_by = s.created_by, original_created_date = s.created_date
      FROM surgical_history s
      WHERE s.id = c.surgical_history_id AND c.original_created_by IS NULL;

      UPDATE claim_encounter_copy_patient_problems c
      SET original_created_by = s.created_by, original_created_date = s.created_date
      FROM patient_problems s
      WHERE s.id = c.patient_problem_id AND c.original_created_by IS NULL;

      UPDATE claim_encounter_copy_family_histories c
      SET original_created_by = s.created_by, original_created_date = s.created_date
      FROM family_history s
      WHERE s.id = c.family_history_id AND c.original_created_by IS NULL;

      UPDATE claim_encounter_copy_hospitalizations c
      SET original_created_by = s.created_by, original_created_date = s.created_date
      FROM hospitalizations s
      WHERE s.id = c.hospitalization_id AND c.original_created_by IS NULL;

      UPDATE claim_encounter_copy_current_medications c
      SET original_created_by = s.created_by, original_created_date = s.created_date
      FROM current_medication s
      WHERE s.id = c.current_medication_id AND c.original_created_by IS NULL;

      UPDATE claim_encounter_copy_diagnostic_order_test_results c
      SET original_created_by = s.created_by, original_created_date = s.created_date
      FROM diagnostic_order_tests_result s
      WHERE s.id = c.diagnostic_order_test_result_id AND c.original_created_by IS NULL;

      UPDATE claim_encounter_copy_diagnostic_order_test_reports c
      SET original_created_by = s.created_by, original_created_date = s.created_date
      FROM diagnostic_order_tests_report s
      WHERE s.id = c.diagnostic_order_test_report_id AND c.original_created_by IS NULL;
    </sql>
  </changeSet>
