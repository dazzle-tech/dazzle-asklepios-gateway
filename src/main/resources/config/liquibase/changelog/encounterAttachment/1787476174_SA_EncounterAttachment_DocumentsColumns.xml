<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">
  <changeSet id="add-clinical-document-references-to-encounter-attachment" author="admin">

    <addColumn tableName="encounter_attachments">

      <column name="document_definition_id" type="BIGINT"/>

      <column name="document_version_id" type="BIGINT"/>

    </addColumn>

    <addForeignKeyConstraint
      baseTableName="encounter_attachments"
      baseColumnNames="document_definition_id"
      referencedTableName="document_definition"
      referencedColumnNames="id"
      constraintName="fk_encounter_attachments_document_definition"/>

    <addForeignKeyConstraint
      baseTableName="encounter_attachments"
      baseColumnNames="document_version_id"
      referencedTableName="document_version"
      referencedColumnNames="id"
      constraintName="fk_encounter_attachments_document_version"/>

    <createIndex
      indexName="idx_encounter_attachments_document_definition"
      tableName="encounter_attachments">
      <column name="document_definition_id"/>
    </createIndex>

    <createIndex
      indexName="idx_encounter_attachments_document_version"
      tableName="encounter_attachments">
      <column name="document_version_id"/>
    </createIndex>

  </changeSet>
</databaseChangeLog>
