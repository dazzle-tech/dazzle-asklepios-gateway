<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="H00000000000505" author="hanan253yahya">

    <addColumn tableName="patient_problems">
      <column name="patient_is_free"
              type="boolean"
              defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
    </addColumn>

    <dropNotNullConstraint
      tableName="patient_problems"
      columnName="condition"
      columnDataType="varchar(255)"/>

    <dropNotNullConstraint
      tableName="patient_problems"
      columnName="date_of_diagnosis"
      columnDataType="date"/>


    <dropNotNullConstraint
      tableName="patient_problems"
      columnName="type"
      columnDataType="varchar(50)"/>
    <dropNotNullConstraint
      tableName="patient_problems"
      columnName="condition_status"
      columnDataType="varchar(50)"/>

    <rollback>

      <addNotNullConstraint
        tableName="patient_problems"
        columnName="condition"
        columnDataType="varchar(255)"/>

      <addNotNullConstraint
        tableName="patient_problems"
        columnName="date_of_diagnosis"
        columnDataType="date"/>



      <addNotNullConstraint
        tableName="patient_problems"
        columnName="type"
        columnDataType="varchar(50)"/>
      <addNotNullConstraint
        tableName="patient_problems"
        columnName="condition_status"
        columnDataType="varchar(50)"/>

      <dropColumn
        tableName="patient_problems"
        columnName="patient_is_free"/>

    </rollback>

  </changeSet>

</databaseChangeLog>
