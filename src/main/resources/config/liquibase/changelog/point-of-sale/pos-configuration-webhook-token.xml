<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="2026102604_H_pos_configuration_webhook_token" author="hanan">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <tableExists schemaName="public" tableName="point_of_sale_configuration"/>
      <not>
        <columnExists schemaName="public" tableName="point_of_sale_configuration" columnName="webhook_token"/>
      </not>
    </preConditions>

    <addColumn schemaName="public" tableName="point_of_sale_configuration">
      <column name="webhook_token" type="varchar(500)"/>
    </addColumn>

    <rollback>
      <dropColumn schemaName="public" tableName="point_of_sale_configuration" columnName="webhook_token"/>
    </rollback>
  </changeSet>

</databaseChangeLog>
