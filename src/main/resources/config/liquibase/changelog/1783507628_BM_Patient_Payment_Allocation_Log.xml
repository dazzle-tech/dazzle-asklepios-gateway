<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="BM000000000037_PATIENT_PAYMENT_ALLOCATION_LOG" author="BushraMashaiekh">

  <createTable tableName="patient_payment_allocations_log">

    <column name="id" type="bigint" autoIncrement="true">
      <constraints primaryKey="true" nullable="false"/>
    </column>

    <column name="allocation_id" type="bigint">
      <constraints nullable="false"
                   foreignKeyName="fk_ppal_allocation"
                   referencedTableName="patient_payment_allocations"
                   referencedColumnNames="id"/>
    </column>

    <column name="payment_id" type="bigint">
      <constraints nullable="false"/>
    </column>

    <column name="charge_id" type="bigint">
      <constraints nullable="false"/>
    </column>

    <column name="action" type="varchar(20)">
      <constraints nullable="false"/>
    </column>

    <column name="paid_from_amount" type="numeric(19,4)"/>

    <column name="paid_from_balance" type="numeric(19,4)"/>

    <column name="created_date"
            type="timestamp"
            defaultValueComputed="now()">
      <constraints nullable="false"/>
    </column>

    <column name="last_modified_date"
            type="timestamp"/>

    <column name="payload" type="jsonb"/>

  </createTable>

  <createIndex tableName="patient_payment_allocations_log"
               indexName="ix_ppal_allocation_id">
    <column name="allocation_id"/>
  </createIndex>

  <createIndex tableName="patient_payment_allocations_log"
               indexName="ix_ppal_payment_id">
    <column name="payment_id"/>
  </createIndex>

  <createIndex tableName="patient_payment_allocations_log"
               indexName="ix_ppal_charge_id">
    <column name="charge_id"/>
  </createIndex>

  <createIndex tableName="patient_payment_allocations_log"
               indexName="ix_ppal_action">
    <column name="action"/>
  </createIndex>

</changeSet>

<include file="config/liquibase/sql/payments/patient_payment_allocation_triggers.sql"
         relativeToChangelogFile="false"/>

</databaseChangeLog>
