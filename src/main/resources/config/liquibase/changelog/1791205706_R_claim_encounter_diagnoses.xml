<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="CLAIM_ENCOUNTER_DIAGNOSES" author="Rawan-Yahya">

    <createTable tableName="claim_encounter_diagnoses">

      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="claim_encounter_copy_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="encounter_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="diagnosis_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="type" type="varchar(50)">
        <constraints nullable="false"/>
      </column>

      <column name="suspected" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>

      <column name="major" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>

      <column name="created_date" type="timestamp">
        <constraints nullable="false"/>
      </column>

      <column name="created_by" type="varchar(50)">
        <constraints nullable="false"/>
      </column>

      <column name="last_modified_by" type="varchar(50)"/>

      <column name="last_modified_date" type="timestamp"/>

    </createTable>

    <addForeignKeyConstraint
      baseTableName="claim_encounter_diagnoses"
      baseColumnNames="claim_encounter_copy_id"
      constraintName="fk_claim_encounter_diagnoses_copy"
      referencedTableName="claim_encounter_copies"
      referencedColumnNames="id"
    />

    <addForeignKeyConstraint
      baseTableName="claim_encounter_diagnoses"
      baseColumnNames="encounter_id"
      constraintName="fk_claim_encounter_diagnoses_encounter"
      referencedTableName="patient_encounters"
      referencedColumnNames="id"
    />

    <addForeignKeyConstraint
      baseTableName="claim_encounter_diagnoses"
      baseColumnNames="diagnosis_id"
      constraintName="fk_claim_encounter_diagnoses_diagnosis"
      referencedTableName="icd_diagnosis"
      referencedColumnNames="id"
    />

    <createIndex
      tableName="claim_encounter_diagnoses"
      indexName="idx_claim_encounter_diagnoses_copy">
      <column name="claim_encounter_copy_id"/>
    </createIndex>

    <createIndex
      tableName="claim_encounter_diagnoses"
      indexName="idx_claim_encounter_diagnoses_encounter">
      <column name="encounter_id"/>
    </createIndex>

    <createIndex
      tableName="claim_encounter_diagnoses"
      indexName="idx_claim_encounter_diagnoses_diagnosis">
      <column name="diagnosis_id"/>
    </createIndex>

  </changeSet>
</databaseChangeLog>
