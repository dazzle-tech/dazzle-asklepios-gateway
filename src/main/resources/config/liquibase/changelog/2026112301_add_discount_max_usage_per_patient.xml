<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="2026112301-add-discount-max-usage-per-patient" author="sondos">
    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists tableName="discount" columnName="max_usage_per_patient"/>
      </not>
    </preConditions>
    <addColumn tableName="discount" >
      <column name="max_usage_per_patient" type="integer" >
        <constraints nullable="true"/>
      </column>
    </addColumn>
  </changeSet>

</databaseChangeLog>
