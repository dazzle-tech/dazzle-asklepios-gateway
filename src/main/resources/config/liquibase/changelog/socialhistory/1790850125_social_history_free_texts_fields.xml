<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="FA00000000019" author="faroukdhelea">

    <addColumn tableName="social_history">
      <column name="patient_is_free" type="boolean" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>

      <column name="free_text" type="text"/>
    </addColumn>

    <dropNotNullConstraint
      tableName="social_history"
      columnName="is_current_smoker"
      columnDataType="boolean"/>

    <dropNotNullConstraint
      tableName="social_history"
      columnName="is_previous_smoker"
      columnDataType="boolean"/>

    <dropNotNullConstraint
      tableName="social_history"
      columnName="exposure_to_second_hand_smoke"
      columnDataType="boolean"/>

    <dropNotNullConstraint
      tableName="social_history"
      columnName="alcohol_consumption"
      columnDataType="boolean"/>

    <dropNotNullConstraint
      tableName="social_history"
      columnName="substance_use"
      columnDataType="boolean"/>

    <sql dbms="postgresql">
      DROP INDEX IF EXISTS ux_social_history_patient_active;
    </sql>

    <sql dbms="postgresql"><![CDATA[
      CREATE UNIQUE INDEX ux_social_history_patient_active
        ON social_history (patient_id)
        WHERE status <> 'CANCELLED'
          AND patient_is_free = false;
      ]]></sql>

  </changeSet>

</databaseChangeLog>
