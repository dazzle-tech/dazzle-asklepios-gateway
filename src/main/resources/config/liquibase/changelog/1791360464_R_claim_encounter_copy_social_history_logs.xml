<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="CLAIM_ENCOUNTER_COPY_SOCIAL_HISTORY_LOGS" author="Rawan-Yahya">

    <createTable tableName="claim_encounter_copy_social_history_logs">

      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="claim_encounter_copy_social_history_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="operation_type" type="varchar(20)">
        <constraints nullable="false"/>
      </column>

      <column name="log_date" type="timestamp">
        <constraints nullable="false"/>
      </column>

      <column name="log_by" type="varchar(50)"/>

      <column name="is_current_smoker" type="boolean"/>
      <column name="smoke_start_date" type="date"/>
      <column name="cigarette_amount" type="integer"/>
      <column name="cigarette_type" type="varchar(255)"/>
      <column name="is_previous_smoker" type="boolean"/>
      <column name="smoke_quit_date" type="date"/>
      <column name="exposure_to_second_hand_smoke" type="boolean"/>

      <column name="alcohol_consumption" type="boolean"/>
      <column name="type_of_alcohol" type="varchar(255)"/>
      <column name="alcohol_since_when" type="date"/>

      <column name="substance_use" type="boolean"/>
      <column name="route" type="varchar(50)"/>
      <column name="frequency" type="varchar(50)"/>

      <column name="physical_limitation" type="varchar(50)"/>
      <column name="diagnosed_eating_disorders" type="varchar(50)"/>

      <column name="patient_is_free" type="boolean"/>
      <column name="free_text" type="text"/>

      <column name="status" type="varchar(50)"/>

      <column name="cancelled_by" type="varchar(50)"/>
      <column name="cancelled_date" type="timestamp"/>
      <column name="cancellation_reason" type="text"/>

      <column name="created_by" type="varchar(50)"/>
      <column name="created_date" type="timestamp"/>

    </createTable>

    <addForeignKeyConstraint
      baseTableName="claim_encounter_copy_social_history_logs"
      baseColumnNames="claim_encounter_copy_social_history_id"
      constraintName="fk_claim_encounter_copy_social_history_logs_history"
      referencedTableName="claim_encounter_copy_social_histories"
      referencedColumnNames="id"/>

    <createIndex
      tableName="claim_encounter_copy_social_history_logs"
      indexName="idx_claim_encounter_copy_social_history_logs_history">
      <column name="claim_encounter_copy_social_history_id"/>
    </createIndex>

    <sqlFile
      path="config/liquibase/sql/claim_encounter_copy_social_history_log.sql"
      relativeToChangelogFile="false"
      splitStatements="false"
      stripComments="false"/>

  </changeSet>

</databaseChangeLog>
