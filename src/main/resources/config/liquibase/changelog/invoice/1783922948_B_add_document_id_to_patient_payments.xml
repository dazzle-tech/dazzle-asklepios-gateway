<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="bs00000000000056" author="batool">

    <addColumn tableName="patient_payments">

      <column name="document_id" type="bigint"/>

    </addColumn>

    <addForeignKeyConstraint
        baseTableName="patient_payments"
        baseColumnNames="document_id"
        constraintName="fk_payment_document"
        referencedTableName="financial_documents"
        referencedColumnNames="id"/>

    <createIndex indexName="idx_payment_document"
                 tableName="patient_payments">
      <column name="document_id"/>
    </createIndex>

  </changeSet>
</databaseChangeLog>
