<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Vaccine SBS code: belongs to the vaccine (scientific name) and is shared by all its brands.
  -->
  <changeSet id="2026110202_H_VACCINE_CODE" author="hanan">

    <addColumn tableName="vaccine">
      <column name="code" type="varchar(100)"/>
    </addColumn>

    <!-- Existing vaccines get a generated code, they can be edited from Vaccine Setup -->
    <sql>
      UPDATE vaccine
      SET code = 'VAC-' || id
      WHERE code IS NULL;
    </sql>

    <addNotNullConstraint tableName="vaccine" columnName="code" columnDataType="varchar(100)"/>

  </changeSet>

</databaseChangeLog>
