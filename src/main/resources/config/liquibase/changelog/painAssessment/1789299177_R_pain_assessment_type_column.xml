<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="PAIN_ASSESSMENT_TYPE_COLUMN" author="Rawan-Yahya">

    <addColumn tableName="pain_assessment">
      <column name="pain_assessment_type" type="varchar(50)"/>
    </addColumn>

    <update tableName="pain_assessment">
      <column name="pain_assessment_type" value="NUMERIC"/>
      <where>pain_assessment_type IS NULL</where>
    </update>

    <addNotNullConstraint
      tableName="pain_assessment"
      columnName="pain_assessment_type"
      columnDataType="varchar(50)"/>

  </changeSet>

</databaseChangeLog>
