<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="2026112402-drop-fk-discount-approval-user" author="sondos">
    <preConditions onFail="MARK_RAN">
      <foreignKeyConstraintExists foreignKeyName="fk_discount_approval_user"/>
    </preConditions>
    <dropForeignKeyConstraint
      baseTableName="discount"
      constraintName="fk_discount_approval_user"/>
  </changeSet>

  <changeSet id="2026112402-drop-column-discount-approval-user" author="sondos">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="discount" columnName="approval_user_id"/>
    </preConditions>
    <dropColumn tableName="discount" columnName="approval_user_id"/>
  </changeSet>

</databaseChangeLog>
