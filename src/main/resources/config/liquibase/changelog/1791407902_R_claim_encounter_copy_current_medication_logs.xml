<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet
    id="create_claim_encounter_copy_current_medication_logs_table"
    author="Rawan-Yahya">

    <createTable tableName="claim_encounter_copy_current_medication_logs">

      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column
        name="claim_encounter_copy_current_medication_id"
        type="bigint">

        <constraints
          nullable="false"
          foreignKeyName="fk_claim_encounter_copy_current_medication_logs"
          references="claim_encounter_copy_current_medications(id)"/>
      </column>

      <column name="operation_type" type="varchar(50)">
        <constraints nullable="false"/>
      </column>

      <column name="log_date" type="timestamp">
        <constraints nullable="false"/>
      </column>

      <column name="log_by" type="varchar(50)"/>

      <column name="claim_encounter_copy_id" type="bigint"/>
      <column name="current_medication_id" type="bigint"/>

      <column name="active_ingredient_id" type="bigint"/>
      <column name="dosage" type="decimal(10,3)"/>
      <column name="unit" type="varchar(50)"/>
      <column name="frequency" type="varchar(100)"/>
      <column name="start_date" type="date"/>

      <column name="patient_is_free" type="boolean"/>

      <column name="free_text" type="text"/>

      <column name="status" type="varchar(50)"/>

      <column name="cancelled_by" type="varchar(50)"/>
      <column name="cancelled_date" type="timestamp"/>
      <column name="cancellation_reason" type="text"/>

      <column name="created_by" type="varchar(50)"/>
      <column name="created_date" type="timestamp"/>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>

    </createTable>

    <createIndex
      tableName="claim_encounter_copy_current_medication_logs"
      indexName="idx_claim_encounter_copy_current_medication_logs">

      <column name="claim_encounter_copy_current_medication_id"/>

    </createIndex>

    <sqlFile
      path="config/liquibase/sql/claim_encounter_copy_current_medication_log.sql"
      relativeToChangelogFile="false"
      splitStatements="false"/>

  </changeSet>

</databaseChangeLog>
