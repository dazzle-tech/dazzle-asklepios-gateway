<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet
    id="create_claim_encounter_copy_hospitalization_logs_table"
    author="Rawan-Yahya">

    <createTable tableName="claim_encounter_copy_hospitalization_logs">

      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column
        name="claim_encounter_copy_hospitalization_id"
        type="bigint">

        <constraints
          nullable="false"
          foreignKeyName="fk_claim_encounter_copy_hospitalization_logs"
          references="claim_encounter_copy_hospitalizations(id)"/>
      </column>

      <column name="operation_type" type="varchar(50)">
        <constraints nullable="false"/>
      </column>

      <column name="log_date" type="timestamp">
        <constraints nullable="false"/>
      </column>

      <column name="log_by" type="varchar(50)"/>

      <column name="facility" type="varchar(255)"/>
      <column name="reason" type="varchar(255)"/>
      <column name="admission_type" type="varchar(100)"/>
      <column name="date_of_admission" type="date"/>
      <column name="length_of_stay_days" type="int"/>
      <column name="outcomes" type="varchar(255)"/>
      <column name="medical_interventions_performed" type="varchar(1000)"/>

      <column name="patient_is_free" type="boolean"/>

      <column name="free_text" type="text"/>

      <column name="status" type="varchar(50)"/>

      <column name="cancelled_by" type="varchar(50)"/>
      <column name="cancelled_date" type="timestamp"/>
      <column name="cancellation_reason" type="text"/>

      <column name="created_by" type="varchar(50)"/>
      <column name="created_date" type="timestamp"/>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>

    </createTable>

    <createIndex
      tableName="claim_encounter_copy_hospitalization_logs"
      indexName="idx_claim_encounter_copy_hospitalization_logs">

      <column name="claim_encounter_copy_hospitalization_id"/>

    </createIndex>

    <sqlFile
      path="config/liquibase/sql/claim_encounter_copy_hospitalization_log.sql"
      relativeToChangelogFile="false"
      splitStatements="false"/>

  </changeSet>

</databaseChangeLog>
