<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <!-- Create the independent readings table -->
  <changeSet id="FA000000000053" author="faroukdhelea">

    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <tableExists tableName="random_blood_sugar"/>
      </not>
    </preConditions>

    <createTable tableName="random_blood_sugar">

      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="patient_id" type="bigint">
        <constraints
          nullable="false"
          foreignKeyName="fk_random_blood_sugar_patient"
          referencedTableName="patients"
          referencedColumnNames="id"/>
      </column>

      <column name="encounter_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="random_blood_glucose" type="varchar(255)"/>

      <column
        name="is_active"
        type="boolean"
        defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>

      <column name="created_by" type="varchar(50)">
        <constraints nullable="false"/>
      </column>

      <column
        name="created_date"
        type="timestamp"
        defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>

      <column name="last_modified_by" type="varchar(50)"/>

      <column name="last_modified_date" type="timestamp"/>

    </createTable>

    <addForeignKeyConstraint
      baseTableName="random_blood_sugar"
      baseColumnNames="encounter_id"
      referencedTableName="patient_encounters"
      referencedColumnNames="id"
      constraintName="fk_random_blood_sugar_encounter"/>

    <createIndex
      indexName="ix_random_blood_sugar_patient"
      tableName="random_blood_sugar">
      <column name="patient_id"/>
    </createIndex>

    <createIndex
      indexName="ix_random_blood_sugar_encounter"
      tableName="random_blood_sugar">
      <column name="encounter_id"/>
    </createIndex>

  </changeSet>

  <!--
    New changeset identity:
    copy any readings not already represented, verify all legacy readings,
    and remove the legacy column within the same transaction.
  -->
  <changeSet
    id="FA_random_blood_sugar_complete_legacy_migration"
    author="faroukdhelea"
    dbms="postgresql"
    runInTransaction="true">

    <preConditions onFail="HALT" onError="HALT">
      <tableExists tableName="random_blood_sugar"/>

      <columnExists
        tableName="vital_signs"
        columnName="fasting_blood_glucose"/>
    </preConditions>

    <!-- Prevent changes to either dataset during migration -->
    <sql>
      LOCK TABLE vital_signs, random_blood_sugar
        IN ACCESS EXCLUSIVE MODE;
    </sql>

    <!--
      EXCEPT ALL preserves legitimately repeated readings.
      Existing matching destination readings are not inserted again.
      Existing unrelated destination readings are retained.
    -->
    <sql>
      INSERT INTO random_blood_sugar (
        patient_id,
        encounter_id,
        random_blood_glucose,
        is_active,
        created_by,
        created_date,
        last_modified_by,
        last_modified_date
      )
      SELECT
        patient_id,
        encounter_id,
        fasting_blood_glucose,
        is_active,
        created_by,
        created_date,
        last_modified_by,
        last_modified_date
      FROM vital_signs
      WHERE fasting_blood_glucose IS NOT NULL

      EXCEPT ALL

      SELECT
        patient_id,
        encounter_id,
        random_blood_glucose,
        is_active,
        created_by,
        created_date,
        last_modified_by,
        last_modified_date
      FROM random_blood_sugar;
    </sql>

    <!-- Every legacy reading must now be represented in the destination -->
    <sql splitStatements="false"><![CDATA[
      DO $$
        BEGIN
          IF EXISTS (
            SELECT 1
            FROM (
                   SELECT
                     patient_id,
                     encounter_id,
                     fasting_blood_glucose,
                     is_active,
                     created_by,
                     created_date,
                     last_modified_by,
                     last_modified_date
                   FROM vital_signs
                   WHERE fasting_blood_glucose IS NOT NULL

                   EXCEPT ALL

                   SELECT
                     patient_id,
                     encounter_id,
                     random_blood_glucose,
                     is_active,
                     created_by,
                     created_date,
                     last_modified_by,
                     last_modified_date
                   FROM random_blood_sugar
                 ) AS missing_readings
          ) THEN
            RAISE EXCEPTION
              'Legacy glucose migration failed: readings or audit fields are missing';
          END IF;
        END
      $$;
      ]]></sql>

    <!-- Only reached after successful transfer and verification -->
    <dropColumn
      tableName="vital_signs"
      columnName="fasting_blood_glucose"/>

  </changeSet>

</databaseChangeLog>
