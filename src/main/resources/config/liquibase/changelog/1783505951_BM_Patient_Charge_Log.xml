<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="BM000000000035_PATIENT_CHARGE_LOG" author="BushraMashaiekh">

    <createTable tableName="patient_charges_log">

      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="patient_charge_id" type="bigint">
        <constraints nullable="false"
                     foreignKeyName="fk_pcl_charge"
                     referencedTableName="patient_charges"
                     referencedColumnNames="id"/>
      </column>

      <column name="patient_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="encounter_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="plan_id" type="bigint"/>

      <column name="action" type="varchar(20)">
        <constraints nullable="false"/>
      </column>

      <column name="due_amount" type="numeric(19,4)"/>

      <column name="remaining" type="numeric(19,4)"/>

      <column name="currency" type="varchar(10)"/>

      <column name="facility_default_currency" type="varchar(10)"/>

      <column name="created_date"
              type="timestamp"
              defaultValueComputed="now()">
        <constraints nullable="false"/>
      </column>

      <column name="last_modified_date"
              type="timestamp"/>

      <column name="payload" type="jsonb"/>

    </createTable>

    <createIndex indexName="ix_pcl_charge_id"
                 tableName="patient_charges_log">
      <column name="patient_charge_id"/>
    </createIndex>

    <createIndex indexName="ix_pcl_patient_id"
                 tableName="patient_charges_log">
      <column name="patient_id"/>
    </createIndex>

    <createIndex indexName="ix_pcl_encounter_id"
                 tableName="patient_charges_log">
      <column name="encounter_id"/>
    </createIndex>

    <createIndex indexName="ix_pcl_action"
                 tableName="patient_charges_log">
      <column name="action"/>
    </createIndex>

    <createIndex indexName="ix_pcl_created_date"
                 tableName="patient_charges_log">
      <column name="created_date"/>
    </createIndex>

  </changeSet>

  <include file="/config/liquibase/sql/payments/patient_charge_triggers.sql"
           relativeToChangelogFile="false"/>

</databaseChangeLog>
