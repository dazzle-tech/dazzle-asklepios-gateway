<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

  <changeSet id="1786610748" author="sondos">

    <createTable tableName="patient_login_otp">

      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints
          primaryKey="true"
          nullable="false"/>
      </column>

      <column name="patient_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="otp_hash" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>

      <column name="expires_at" type="TIMESTAMP">
        <constraints nullable="false"/>
      </column>

      <column name="verified_at" type="TIMESTAMP"/>

      <column name="attempts" type="INTEGER" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>

      <column name="created_at" type="TIMESTAMP">
        <constraints nullable="false"/>
      </column>

    </createTable>

    <addForeignKeyConstraint
      baseTableName="patient_login_otp"
      baseColumnNames="patient_id"
      constraintName="fk_patient_login_otp_patient"
      referencedTableName="patients"
      referencedColumnNames="id"/>

    <createIndex
      tableName="patient_login_otp"
      indexName="idx_patient_login_otp_patient_id">

      <column name="patient_id"/>

    </createIndex>

    <createIndex
      tableName="patient_login_otp"
      indexName="idx_patient_login_otp_expires_at">

      <column name="expires_at"/>

    </createIndex>

  </changeSet>

</databaseChangeLog>
