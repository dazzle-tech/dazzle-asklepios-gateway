<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="ENCOUNTER_ASSESSMENTS_AUDIT" author="Rawan-Yahya">
    <createTable tableName="encounter_assessments_log">

      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="encounter_assessment_id" type="bigint">
        <constraints nullable="false"
                     referencedTableName="encounter_assessments"
                     referencedColumnNames="id"
                     foreignKeyName="fk_enc_assessment_log_assessment"/>
      </column>

      <column name="operation_type" type="varchar(10)">
        <constraints nullable="false"/>
      </column>

      <column name="old_value" type="text"/>

      <column name="new_value" type="text"/>

      <column name="log_date" type="timestamp">
        <constraints nullable="false"/>
      </column>

      <column name="log_by" type="varchar(50)"/>
    </createTable>

    <createIndex tableName="encounter_assessments_log"
                 indexName="idx_enc_assessment_log_assessment">
      <column name="encounter_assessment_id"/>
    </createIndex>

    <createIndex tableName="encounter_assessments_log"
                 indexName="idx_enc_assessment_log_date">
      <column name="log_date"/>
    </createIndex>
  </changeSet>




</databaseChangeLog>
