<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="CLAIM_ENCOUNTER_PROGRESS_NOTE_LOGS" author="Rawan-Yahya">

    <createTable tableName="claim_encounter_progress_note_logs">

      <column name="id" type="bigint" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="claim_encounter_progress_note_id" type="bigint">
        <constraints nullable="false"/>
      </column>

      <column name="operation_type" type="varchar(20)">
        <constraints nullable="false"/>
      </column>

      <column name="log_date" type="timestamp">
        <constraints nullable="false"/>
      </column>

      <column name="log_by" type="varchar(50)"/>

      <column name="note_text" type="text"/>

      <column name="cancelled_by" type="varchar(50)"/>

      <column name="cancelled_date" type="timestamp"/>

      <column name="cancellation_reason" type="text"/>

      <column name="created_by" type="varchar(50)"/>

      <column name="created_date" type="timestamp"/>

    </createTable>

    <addForeignKeyConstraint
      baseTableName="claim_encounter_progress_note_logs"
      baseColumnNames="claim_encounter_progress_note_id"
      constraintName="fk_claim_encounter_progress_note_logs_note"
      referencedTableName="claim_encounter_progress_notes"
      referencedColumnNames="id"/>

    <createIndex
      tableName="claim_encounter_progress_note_logs"
      indexName="idx_claim_encounter_progress_note_logs_note">
      <column name="claim_encounter_progress_note_id"/>
    </createIndex>

    <sqlFile
      path="config/liquibase/sql/claim_encounter_progress_note_log.sql"
      relativeToChangelogFile="false"
      splitStatements="false"
      stripComments="false"/>

  </changeSet>
</databaseChangeLog>
